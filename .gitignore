.arts/
.mossx/

# AI 助手临时截图/裁图产物
.qoder-*.png
.tmp-crop-*.png

# 验收截图归档（本地留存，不入库）
docs/screenshots/

# 优化方案 / 技术债 / 样式规约文档（本地沉淀，不入库；CLAUDE.md 要求继续写入此目录）
docs/optimizations/

# 安全审计报告与发布评审产物（含未修复项清单，公开远端不宜暴露，本地留存）
deliverables/

# 阿里云 OSS 密钥（本地环境变量脚本，绝不入仓）
oss-keys.bat

# WorkBuddy 项目记忆（含服务器凭据/密码，勿入库）
.workbuddy/

# 前端构建备份与 vite 临时文件
frontend/dist.bak/
frontend/dist.bak-pre/
frontend/dist.bak2-*/
frontend/dist.prelaunch-*/
frontend/*.timestamp-*.mjs

# Bangumi 日历 / 番剧详情本地缓存备份
scripts/bangumi-calendar.local.json
scripts/bangumi-bgm-local/

# graphify 知识图谱产物（本地生成，6MB+，用 graphify update . 重建）
graphify-out/

# CDP 调试用的 Edge 独立用户配置（579MB，调试管理端时生成）
.edge-test-profile/
graphify-update.log
backend-run.log

# 一次性 CDP 探针脚本（硬编码本机端口，仅排查管理端白屏时临时使用）
scripts/_admin_probe.mjs

# 本机临时启动脚本（含个人路径，密码走环境变量注入，不入库）
scripts/_run-backend-detached.ps1

# 环境变量与私钥（预防性：防止误提交敏感文件；示例文件可提交）
.env
*.env
.env.*
!.env.example
!*.env.example
*.pem
*.key
id_rsa
id_rsa.pub
*.p12
*.jks
