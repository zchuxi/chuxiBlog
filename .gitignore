# 构建产物
backend/target/
frontend/dist/
frontend/dist_fresh*/
frontend/node_modules/

# 运行时数据
backend/uploads/
*.log
nohup.out

# Python 字节码缓存（部署脚本运行产物）
__pycache__/
*.pyc

# IDE / 系统
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# 本地素材（网站图标已在 frontend/public 内，源图不入库）
avatar.png

# Claude 会话内部文件
.claude/
.qoder/

# AI 助手临时截图/裁图产物
.qoder-*.png
.tmp-crop-*.png

# 验收截图归档（本地留存，不入库）
docs/screenshots/

# 阿里云 OSS 密钥（本地环境变量脚本，绝不入仓）
oss-keys.bat

# WorkBuddy 项目记忆（含服务器凭据/密码，勿入库）
.workbuddy/

# 前端构建备份与 vite 临时文件
frontend/dist.bak/
frontend/*.timestamp-*.mjs

# Bangumi 日历本地缓存备份
scripts/bangumi-calendar.local.json

# graphify 知识图谱产物（本地生成，6MB+，用 graphify update . 重建）
graphify-out/
