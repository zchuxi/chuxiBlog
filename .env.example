# =============================================================================
# 环境变量模板（脱敏示例，可提交）。真实值严禁入仓——.env / .env.* 已被 gitignore。
# 使用：复制为 .env 并按环境填写，或在部署平台 / CI Secret 中注入同名变量。
# =============================================================================

# ---------- 后端运行（application.yml 占位符，本地 dev 可全部留空走默认值） ----------
# 生产必须显式设置：
DB_URL=jdbc:mysql://127.0.0.1:3306/chuxi_db?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=chuxi
DB_PASSWORD=__change_me__
# 生产固定 validate（不会自动改表）；本地 dev 默认 update
JPA_DDL_AUTO=validate
SERVER_PORT=8080
SERVER_ADDRESS=127.0.0.1
SPRING_PROFILES_ACTIVE=prod

# AI 助手（不启用则 APP_AI_ENABLED=false）
APP_AI_ENABLED=false
APP_AI_BASE_URL=https://api.deepseek.com/v1
APP_AI_API_KEY=__change_me__
APP_AI_MODEL=deepseek-chat
APP_AI_TIMEOUT_SECONDS=20
APP_AI_MAX_CONTEXT_ARTICLES=5

# 对象存储（媒体文件）
APP_OSS_ENABLED=true
APP_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
APP_OSS_BUCKET=__your_bucket__
APP_OSS_ACCESS_KEY_ID=__change_me__
APP_OSS_ACCESS_KEY_SECRET=__change_me__
APP_OSS_PREFIX=uploads/
APP_OSS_BASE_URL=

# Bangumi 第三方 API 令牌（可选，提高限流配额）
APP_BANGUMI_TOKEN=
# 后端位于 nginx 反代之后时开启（正确识别客户端 IP）
APP_TRUST_PROXY=true

# ---------- 部署脚本（scripts/deploy/*.py、scripts/fetch_and_upload_*.py） ----------
# 最小权限部署账户 + 私钥认证；known_hosts 须先经人工核验登记主机密钥
SSH_HOST=__your_server_ip__
SSH_PORT=22
SSH_USER=deploy
SSH_KEY_PATH=~/.ssh/id_ed25519_deploy
SSH_KNOWN_HOSTS=~/.ssh/known_hosts
# 本地产物路径（按实际构建输出调整）
JAR_LOCAL=D:/build/chuxi-backend2/target/chuxi-backend.jar
DIST_TGZ=D:/workspace/dist_build.tgz
# 服务器备份保留天数
BACKUP_KEEP_DAYS=14

# ---------- 本机辅助脚本（可选） ----------
# bgm.tv API 令牌（scripts/fetch_and_upload_bangumi_subjects.py）
BGM_TOKEN=
# 番剧记录来源，默认线上站点
RECORDS_URL=https://www.chuxi.online/api/front/bangumi
# 本机代理（fetch 脚本访问 api.bgm.tv 时需要）
HTTPS_PROXY=http://127.0.0.1:7890
